NEXT_PUBLIC_SITE_URL=https://larabeauty.store
NEXT_PUBLIC_API_URL=https://api.larabeauty.store
NEXT_PUBLIC_WHATSAPP_NUMBER=12402107635
NEXT_PUBLIC_WHATSAPP_DISPLAY=+1 (240) 210-7635
NEXT_PUBLIC_SUPPORT_PHONE=+1 (240) 210-7635
NEXT_PUBLIC_SUPPORT_EMAIL=support@larabeauty.store

# Server-only — Google Sheets order webhook (Apps Script URL)
# Spreadsheet: https://docs.google.com/spreadsheets/d/1n_vZl2t3X_KV0Rkpj6dR9TZRRm3OETv3IjIdzcH-diU
# Deploy script: docs/sheets/UAE_ORDERS_WEBHOOK.gs (tab: Tabellenblatt1)
GOOGLE_SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# Optional: persistent order store + replay unsynced orders to Sheets
ORDERS_DATA_DIR=/app/data
ORDERS_SYNC_SECRET=

# Marketing pixels (client-side — baked in at build time)
NEXT_PUBLIC_ENABLE_PIXELS=true
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=998e0cce-14e8-4cfb-b55e-e7eea8fe5f25

# TikTok Events API (server-only — set in EasyPanel, never commit)
TIKTOK_ACCESS_TOKEN=
TIKTOK_PIXEL_ID=D9V4EIJC77U9RA6QKBL0

# Snap Conversions API (server-only — set in EasyPanel, never commit)
SNAP_ACCESS_TOKEN=
SNAP_PIXEL_ID=998e0cce-14e8-4cfb-b55e-e7eea8fe5f25
# Optional: Snap Events Manager test code (remove in production)
SNAP_TEST_EVENT_CODE=

# Redirect admin dashboard (/admin/redirects) — defaults to SHEETS_WEBHOOK_SECRET
REDIRECT_ADMIN_SECRET=

# Redirect Killer dashboard (/redirectkiller) — separate password, required for access
REDIRECTKILLER_ADMIN_PASSWORD=

# COD Admin dashboard (/admin/cod)
COD_ADMIN_USERNAME=
COD_ADMIN_PASSWORD=
COD_GEO_ALLOWED_COUNTRIES=AE
COD_GEO_STRICT=true
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_COUNTRY_DB_PATH=
MAXMIND_ANON_DB_PATH=
IPQS_API_KEY=
VPN_DETECTOR_API_KEY=
